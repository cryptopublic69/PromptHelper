{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PromptHelper · 提示词工作台",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 24 },
        "theme": "Dark",
        "backgroundColor": "#0b1018"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "本地提示词资料库与多标签工作台",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
